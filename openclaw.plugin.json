{
  "id": "openclaw-umans-usage",
  "name": "Umans wallet & usage dashboard",
  "description": "Surfaces Umans wallet balance (when available), burst limits, and token usage in OpenClaw's Provider Plans & Billing dashboard.",
  "version": "0.1.4",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "umans"
  ],
  "contracts": {
    "usageProviders": [
      "umans"
    ]
  },
  "extensions": [
    "./dist/index.js"
  ],
  "minGatewayVersion": "2026.7.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "setup": {
    "providers": [
      {
        "id": "umans",
        "envVars": [
          "UMANS_API_KEY"
        ]
      }
    ]
  }
}
